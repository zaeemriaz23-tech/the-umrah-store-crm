PORT=3000
# Local development only. On Hostinger use an absolute persistent path outside hbuilds.
# DATA_DIR=./data
# Hostinger example: DATA_DIR=/home/u544159223/umrah-data
# Optional one-time source for safe copy migration (remove after migration is verified).
# LEGACY_DATA_DIR=/home/u544159223/hbuilds/versions/OLD_VERSION/nodejs/data
# Required only for a deliberate first-time installation; never enable on an existing production site.
# ALLOW_EMPTY_DB=1
# Strong password used only when creating an admin or with RESET_ADMIN=1. Existing admin passwords remain unchanged.
ADMIN_PASSWORD=
# Force-reset the admin password on next start (set to 1 only intentionally, then remove).
RESET_ADMIN=
SERPAPI_KEY=
GROQ_API_KEY=
GROQ_MODEL=
PUBLIC_URL=https://portal.theumrahstore.com
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
