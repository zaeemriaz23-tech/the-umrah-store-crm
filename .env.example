PORT=3000
DATA_DIR=./data
# Admin password used on first start (login: admin). If unset, the legacy default is used and a banner asks you to change it.
ADMIN_PASSWORD=
# Force-reset the admin password to ADMIN_PASSWORD on next start (then remove this line)
RESET_ADMIN=
# Live flight & hotel search (can also be pasted in Settings > Integrations)
SERPAPI_KEY=
# AI assistant (Groq). Can also be pasted in Settings > AI assistant. Simple commands work without it.
GROQ_API_KEY=
# Optional model override (otherwise chosen in Settings > AI assistant)
GROQ_MODEL=

# Public site URL (canonical links, sitemap, Open Graph). Falls back to the request host.
PUBLIC_URL=

# --- v3.8 ---------------------------------------------------------------
# Public address of the site (used in email links and sitemap). Example: https://theumrahstore.com
PUBLIC_URL=
# Optional: email accounts are configured in the CRM (Settings > Email & notifications), not here.
# Optional: keep data OUTSIDE the deployed folder so redeploys never touch it (recommended on Hostinger)
# DATA_DIR=/home/uXXXXXXXX/umrah-data
# GROQ_MODEL=openai/gpt-oss-120b

# --- MySQL primary storage (when configured, MySQL is authoritative) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=0
DB_POOL_SIZE=5
# MySQL state snapshots: backup at most once every six hours, retain last 30
DB_BACKUP_INTERVAL_MS=21600000
DB_BACKUP_KEEP=30
