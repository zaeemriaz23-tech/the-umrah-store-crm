PORT=3000
DATA_DIR=./data
# Admin password used on first start (login: admin). If unset, the legacy default is used and a banner asks you to change it.
ADMIN_PASSWORD=
# Force-reset the admin password to ADMIN_PASSWORD on next start (then remove this line)
RESET_ADMIN=
# Live flight & hotel search (can also be pasted in Settings > Integrations)
SERPAPI_KEY=
# AI assistant (Groq). Can also be pasted in Settings > AI assistant. Simple commands work without it.
GROQ_API_KEY=
# Optional model override (otherwise chosen in Settings > AI assistant)
GROQ_MODEL=

# Public site URL (canonical links, sitemap, Open Graph). Falls back to the request host.
PUBLIC_URL=

# --- v3.8 ---------------------------------------------------------------
# Public address of the site (used in email links and sitemap). Example: https://theumrahstore.com
PUBLIC_URL=
# Optional: email accounts are configured in the CRM (Settings > Email & notifications), not here.
# Optional: keep data OUTSIDE the deployed folder so redeploys never touch it (recommended on Hostinger)
# DATA_DIR=/home/uXXXXXXXX/umrah-data
# GROQ_MODEL=openai/gpt-oss-120b

# --- MySQL primary storage -------------------------------------------------
# When DB_HOST/DB_NAME/DB_USER/DB_PASSWORD are set, MySQL is the ONLY source of truth.
# If MySQL is configured but unreachable the app stays offline (/healthz = 503); it never falls back to JSON.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# 0 = off, 1 = TLS with certificate verification, insecure = TLS without verification
DB_SSL=0
DB_POOL_SIZE=5
# Must be an ABSOLUTE folder outside the deployed app when MySQL is used (holds receipts, uploads and the recovery snapshot db.json)
# DATA_DIR=/home/u544159223/umrah-data
# Automatic database backups (stored in table crm_backups): at most one per interval, keep the newest N
DB_BACKUP_INTERVAL_MS=21600000
DB_BACKUP_KEEP=30
# Advanced (defaults are fine): attempts per commit, first retry delay, per-attempt timeout
# DB_WRITE_RETRIES=4
# DB_RETRY_BASE_MS=200
# DB_WRITE_TIMEOUT_MS=20000
# SHUTDOWN_TIMEOUT_MS=20000
